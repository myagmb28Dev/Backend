# Default: ignore everything in repository root/context
*
.gradle-user/
/backup/
src/main/resources/static/

# Allow only files needed by Dockerfile build steps
!.dockerignore
!Dockerfile
!build/
!build/libs/
!build/libs/app.jar
!scripts/healthcheck-adaptive.sh
!scripts/docker-entrypoint.sh
src/main/resources/application-local.yml
src/main/resources/application-test.yml
src/test/resources/application-test.yml
